# ==============================================================================
# AcadPredict Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your custom secrets.
# Do NOT commit your production .env file to version control.

# --- MySQL Database Configuration ---
DB_ROOT_PASSWORD=rootpassword
DB_NAME=acadpredict
DB_USERNAME=acaduser
DB_PASSWORD=acadpass
# Host port mapping for MySQL (default 3307 prevents conflict with local MySQL service)
MYSQL_HOST_PORT=3307

# --- Spring Boot Backend Configuration ---
# Must be a Base64-encoded string representing at least 256 bits (32 bytes)
JWT_SECRET=dGVzdC1zZWNyZXQta2V5LWZvci1qd3QtYXV0aGVudGljYXRpb24tc2VjdXJlLTMyLWJ5dGVzCg==
# Allowed CORS Origin for browser requests
FRONTEND_URL=http://localhost:5173
# Persistent filesystem storage path for uploaded project documents
DOCUMENT_STORAGE_DIR=/app/uploads

# --- Development Account Provisioning ---
# Set to true in local development environments to automatically seed safe test
# accounts for FACULTY and COORDINATOR roles. Disabled by default in production.
DEV_PROVISION_ACCOUNTS=true
DEV_FACULTY_EMAIL=faculty@college.edu
DEV_FACULTY_PASSWORD=FacultyPass123!
DEV_COORDINATOR_EMAIL=coordinator@college.edu
DEV_COORDINATOR_PASSWORD=CoordinatorPass123!

# --- React / Vite Frontend Configuration ---
# Backend URL accessed by the client's web browser
VITE_API_URL=http://localhost:8081
